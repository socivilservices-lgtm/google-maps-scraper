# Official Places API (New). When this is set, backend=auto uses it.
GOOGLE_PLACES_API_KEY=

# Optional operator key. It can read every job. Leave empty and use per-user keys.
GMAPS_SERVICE_API_KEY=

# Postgres (Supabase-compatible). Empty uses SQLite in GMAPS_OUTPUT_DIR.
DATABASE_URL=

# Signs session cookies. Use a long random value in production.
SECRET_KEY=

# This email is the free unlimited admin.
ADMIN_EMAIL=

# Public origin, no trailing path. Stripe return URLs use it.
APP_BASE_URL=http://127.0.0.1:8000

# Leave all three empty to run with billing disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

GMAPS_COOKIE_SECURE=false
GMAPS_TRUST_PROXY=false

GMAPS_BACKEND=auto
GMAPS_MAX_RESULTS=20
GMAPS_HEADLESS=true
GMAPS_DELAY_MIN=2
GMAPS_DELAY_MAX=5
GMAPS_TIMEOUT=30
GMAPS_RETRIES=3
GMAPS_PROXIES_FILE=
GMAPS_USER_DATA_DIR=
GMAPS_OUTPUT_DIR=output
GMAPS_EXTRACT_EMAILS=true
GMAPS_REGION=US
