# Official Places API (New). When this is set, backend=auto uses it.
GOOGLE_PLACES_API_KEY=

# Required before you expose the HTTP service.
GMAPS_SERVICE_API_KEY=

GMAPS_BACKEND=auto
GMAPS_MAX_RESULTS=20
GMAPS_HEADLESS=true
GMAPS_DELAY_MIN=2
GMAPS_DELAY_MAX=5
GMAPS_TIMEOUT=30
GMAPS_RETRIES=3
GMAPS_PROXIES_FILE=
GMAPS_USER_DATA_DIR=
GMAPS_OUTPUT_DIR=output
GMAPS_EXTRACT_EMAILS=true
GMAPS_REGION=US
